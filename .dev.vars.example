# คัดลอกเป็น .dev.vars (gitignored) แล้วเติมค่า
# APP_URL = origin ที่เปิดเว็บตอน dev (vite)
APP_URL=http://localhost:5173
# DEV_AUTH=1 เปิดปุ่ม dev-login (ห้ามเปิดบน production เด็ดขาด)
DEV_AUTH=1
# จาก Google Cloud Console → OAuth client (Web) · redirect URI = {APP_URL}/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# อีเมลกลาง (P3): key เข้ารหัส secret/token ใน D1 — สร้างด้วย `openssl rand -base64 32` (production = wrangler secret put)
INBOX_ENC_KEY=

# Secret Vault: key เข้ารหัสรหัสผ่าน/notes ใน D1 — สร้างด้วย `openssl rand -base64 32` แยกจาก INBOX_ENC_KEY เด็ดขาด (production = wrangler secret put)
VAULT_ENC_KEY=

# Second Brain: เชื่อม LINE Messaging API (production = wrangler secret put ทั้ง 3 ตัว)
# LINE_CHANNEL_SECRET = จาก LINE Developers Console > Basic settings — ใช้ verify webhook signature
LINE_CHANNEL_SECRET=
# LINE_CHANNEL_ACCESS_TOKEN = จาก LINE Developers Console > Messaging API — ใช้ดึงชื่อผู้ส่ง (best-effort)
LINE_CHANNEL_ACCESS_TOKEN=
# LINE_SECOND_BRAIN_GROUP_ID = Group ID ของห้องแชท LINE ที่จะดักลิงก์ (เจาะจงห้องเดียว)
LINE_SECOND_BRAIN_GROUP_ID=
